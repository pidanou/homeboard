# PostgreSQL
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://familyboard:${POSTGRES_PASSWORD}@localhost:5432/familyboard?sslmode=disable

# Server
JWT_SECRET=change-me-to-a-long-random-secret
PORT=8080
# Public URL of the backend API — used to build avatar URLs stored in the database
API_BASE_URL=http://localhost:8080
# Frontend URL added to CORS allowed origins
APP_BASE_URL=http://localhost:3000
# Comma-separated extra CORS origins, or * to allow all (e.g. for Capacitor apps)
CORS_ALLOWED_ORIGINS=
# Directory for avatar uploads (defaults to ./uploads)
UPLOAD_DIR=

# Registration is open only until the first user is created (Coolify-style bootstrap).
# Set to true to re-open registration when you need to add more accounts.
ALLOW_REGISTRATION=false

# Set to true to allow multiple households (SaaS mode). Default is single-household (local mode).
ALLOW_MULTI_HOUSEHOLD=false

# Single Sign-On via OIDC (optional) — set false to require OIDC and disable email/password login
ALLOW_PASSWORD_LOGIN=true
# All three required to enable OIDC — leave empty to disable
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Override if a reverse proxy rewrites the callback path (defaults to ${API_BASE_URL}/api/v1/auth/oidc/callback)
OIDC_REDIRECT_URL=
# Shown on the frontend login button, e.g. "Sign in with Authentik"
OIDC_PROVIDER_NAME=SSO

# SMTP (optional) — leave SMTP_HOST empty to disable email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=false

# Web Push / VAPID (optional) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# How often to re-fetch external calendar subscriptions (Go duration string, 5m floor)
CALENDAR_SYNC_INTERVAL=1h
